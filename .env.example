# Copy this file to .env and paste your keys after the = signs.
# You only need the keys for the engines you want to test.
# Missing keys are skipped and listed as "not tested" in the report.
# Never commit .env. It is listed in .gitignore.
#
# Tip: if another tool on your machine already uses ANTHROPIC_API_KEY (for example an
# AI coding assistant), set AEO_ANTHROPIC_API_KEY instead. AEO_-prefixed names win.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
